# ============ 对话模型：DeepSeek ============
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_CHAT_MODEL=deepseek-chat

# ============ Embedding / Rerank：智谱（与对话分离） ============
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ============ 服务 ============
APP_HOST=0.0.0.0
APP_PORT=8000

# ============ 路径 ============
DATA_DIR=./data
BOOKS_DIR=./data/books
CHROMA_DIR=./chroma_db
SQLITE_PATH=./data/novel_rag.db

# ============ 小说切分 ============
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
MIN_CHAPTER_CHARS=200

# ============ 检索 ============
# 最终送入 LLM 的片段数（rerank 后也会截到这个数；过大易引入噪声）
RETRIEVAL_TOP_K=3
# 向量相似度下限，小说对白/别名题可略降（0.2~0.28）
RETRIEVAL_SCORE_THRESHOLD=0.22
HYBRID_SEARCH_ENABLED=true
# 混合检索 / Rerank 前的候选池，越大越不易漏「介绍场景」
HYBRID_RECALL_TOP_K=20
RERANK_ENABLED=true
RERANK_RECALL_TOP_K=20
# 重排后保留并送入 LLM 的条数（真名题建议 6~10）
RERANK_TOP_N=8

# ============ 日志 ============
LOG_LEVEL=INFO
